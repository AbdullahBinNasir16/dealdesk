# Copy to backend/.env for local development. NEVER commit the real .env file.

# Your group's Claude API key
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
MODEL=claude-haiku-5-5
MAX_TOKENS=600

# Neon / Supabase Postgres connection string (long-term memory + LangGraph checkpoints).
# Leave empty to use a local SQLite file (development only, NOT for deployment).
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Long random string used to sign dealer login tokens
ADMIN_SECRET=change-me-to-a-long-random-string

# Allowed website origins, comma separated (e.g. https://dealdesk.vercel.app) or *
CORS_ORIGINS=*

# Optional: override demo dealer passwords on first seed
# ADMIN_PASSWORD_SKYLINE=...
# ADMIN_PASSWORD_CAPITAL=...
# ADMIN_PASSWORD_PRIME=...
# ADMIN_PASSWORD_AUTOHUB=...
